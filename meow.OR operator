
#include <stdio.h>

int main()
{
    int num1, num2;

    printf("Enter the first number: ");
    scanf("%d", &num1);

    printf("Enter the second number: ");
    scanf("%d", &num2);

    if(num1 > 10 || num2 > 10)
    {
        printf("At least one condition is true.");
    }
    else
    {
        printf("Both conditions are false.");
    }

    return 0;
}
